{
  "name": "yu-wuwang",
  "version": "0.1.3",
  "description": "豫 · 无妄 — 网易云桌面播放器（真无损 / ASIO 独占）",
  "main": "app/main.js",
  "author": "tianz",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "engine": "node engine/index.js",
    "dist": "electron-builder --win --publish never",
    "pack": "electron-builder --win --dir --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "pack:mac": "electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tianz.yuwuwang",
    "productName": "YuWuwang",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "engine/**/*",
      "native/**/*",
      "assets/**/*",
      "tools/**/*",
      "package.json",
      "!**/*.log",
      "!tools/*.png",
      "!tools/*.m3u"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "豫 · 无妄"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "本应用不使用麦克风，此项仅为通过公证校验占位",
        "LSMinimumSystemVersion": "11.0"
      }
    }
  }
}